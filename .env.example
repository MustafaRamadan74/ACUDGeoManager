# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=acud_geom_db
POSTGRES_PORT=5434

# Backend API Configuration
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=acud_geom_db;Username=postgres;Password=postgres_password;Include Error Detail=true

# JWT Configuration
Jwt__Issuer=ACUDGeoManager
Jwt__Audience=ACUDGeoManagerClient
Jwt__Secret=SuperSecretKeyAtLeast32BytesLongForSecurityTestingOnly1234567890!
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# Initial Admin Bootstrap
Admin__Username=admin
Admin__Email=admin@acud.gov.eg
Admin__Password=Admin@Passw0rd123!

# Seed Users Credentials
Seed__Admin__Username=admin
Seed__Admin__Email=admin@acud.gov.eg
Seed__Admin__Password=Admin@Passw0rd123!

Seed__Editor__Username=editor
Seed__Editor__Email=editor@acud.gov.eg
Seed__Editor__Password=Editor@Passw0rd123!

Seed__Viewer__Username=viewer
Seed__Viewer__Email=viewer@acud.gov.eg
Seed__Viewer__Password=Viewer@Passw0rd123!

# CORS Configuration
Cors__AllowedOrigins=http://localhost:3000

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

